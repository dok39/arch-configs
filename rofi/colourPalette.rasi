* {
  /* Backgrounds */
  background:     #1e1e2e;  
  background-alt: #313244;  

  /* Foreground */
  foreground:     #cdd6f4; 

  /* Selection */
  selected:       #cdd6f4;
  selected-fg:    #f5e0dc;   
  active:         #94e2d5;   
  urgent:         #fe640b;   

  /* Border */
  border-color:   #94e2d5;  
}